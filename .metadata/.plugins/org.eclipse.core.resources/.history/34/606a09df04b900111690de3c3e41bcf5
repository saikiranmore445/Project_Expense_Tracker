package com.expenseanalyzer.util;

public final class ConsoleUtil {

    // ANSI color codes
    private static final String RESET = "\u001B[0m";
    private static final String RED = "\u001B[31m";
    private static final String GREEN = "\u001B[32m";
    private static final String YELLOW = "\u001B[33m";
    private static final String CYAN = "\u001B[36m";

    // Prevent object creation
    private ConsoleUtil() {
    }

    // =========================================================
    // SUCCESS MESSAGE
    // =========================================================

    public static void printSuccess(String message) {

        System.out.println(
                GREEN + "SUCCESS: " + message + RESET
        );
    }

    // =========================================================
    // ERROR MESSAGE
    // =========================================================

    public static void printError(String message) {

        System.out.println(
                RED + "ERROR: " + message + RESET
        );
    }

    // =========================================================
    // WARNING MESSAGE
    // =========================================================

    public static void printWarning(String message) {

        System.out.println(
                YELLOW + "WARNING: " + message + RESET
        );
    }

    // =========================================================
    // INFORMATION MESSAGE
    // =========================================================

    public static void printInfo(String message) {

        System.out.println(
                CYAN + message + RESET
        );
    }

    // =========================================================
    // HEADER
    // =========================================================

    public static void printHeader(String title) {

        System.out.println();
        System.out.println(
                "=============================================="
        );
        System.out.println(
                "              " + title
        );
        System.out.println(
                "=============================================="
        );
    }

    // =========================================================
    // SEPARATOR
    // =========================================================

    public static void printSeparator() {

        System.out.println(
                "----------------------------------------------"
        );
    }
}
public static void main(String[] args) {

    printSuccess("Expense added successfully.");

    printError("Expense ID already exists.");

    printWarning("No expenses found.");

    printInfo("Expense report generated.");

    printHeader("EXPENSE REPORT");

    printSeparator();
}