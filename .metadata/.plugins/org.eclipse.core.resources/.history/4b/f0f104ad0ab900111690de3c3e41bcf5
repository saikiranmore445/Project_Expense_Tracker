public class Main {

    private static final Scanner scanner = new Scanner(System.in);

    // Repository
    private static final ExpenseRepository expenseRepository =
            new InMemoryExpenseRepository();

    // Service
    private static final ExpenseService expenseService =
            new ExpenseService(expenseRepository);
    
    private static final AnalysisService analysisService =
            new AnalysisService(expenseRepository);
    private static final ReportService reportService =
            new ReportService(expenseRepository);

    // ANSI color codes
    private static final String GREEN = "\u001B[32m";
    private static final String RED = "\u001B[31m";
    private static final String RESET = "\u001B[0m";

    public static void main(String[] args) {

        boolean running = true;

        System.out.println();
        System.out.println("==============================================");
        System.out.println("          EXPENSE PATTERN ANALYZER");
        System.out.println("==============================================");

        while (running) {

            displayMenu();

            int choice = readInt("Enter your choice: ");

            try {

                switch (choice) {

                    case 1:
                        addExpense();
                        break;

                    case 2:
                        viewAllExpenses();
                        break;

                    case 3:
                        findExpense();
                        break;

                    case 4:
                        updateExpense();
                        break;

                    case 5:
                        deleteExpense();
                        break;

                    case 6:
                        showExpenseCount();
                        break;

                    case 7:
                        showAnalysisMenu();
                        break;

                    case 8:
                        showReportMenu();
                    break;

                case 9:
                    deleteAllExpenses();
                    break;

                    case 0:
                        running = false;

                        printSuccess(
                                "Thank you for using Expense Pattern Analyzer!"
                        );
                        break;

                    default:
                        printError(
                                "Invalid choice. Please select a valid option."
                        );
                }

            } catch (InvalidExpenseException
                    | DuplicateExpenseException
                    | ExpenseNotFoundException e) {

                printError(e.getMessage());
            }
        }

        scanner.close();
    }

    // =========================================================
    // DISPLAY MENU
    // =========================================================

    private static void displayMenu() {

        System.out.println();
        System.out.println("----------------------------------------------");
        System.out.println("                    MENU");
        System.out.println("----------------------------------------------");
        System.out.println("1. Add Expense");
        System.out.println("2. View All Expenses");
        System.out.println("3. Find Expense by ID");
        System.out.println("4. Update Expense");
        System.out.println("5. Delete Expense");
        System.out.println("6. View Expense Count");
        System.out.println("7. Expense Analysis");
        System.out.println("8. Expense Reports");
        System.out.println("9. Delete All Expenses");
        System.out.println("0. Exit");
        System.out.println("----------------------------------------------");
    }

    // =========================================================
    // ADD EXPENSE
    // =========================================================

    private static void addExpense() {

        System.out.println();
        System.out.println("============== ADD EXPENSE ==============");

        // Take ID
        Long expenseId = readLong("Enter Expense ID: ");

        // Immediately check duplicate ID
        if (expenseService.expenseExists(expenseId)) {

            throw new DuplicateExpenseException(
                    "Expense ID " + expenseId
                            + " already exists. Please use a different ID."
            );
        }

        // Take amount
        double amount = readDouble("Enter Amount: ");

        // Take category
        Category category = readCategory();

        // Take description
        String description = readString("Enter Description: ");

        // Take date from user
        LocalDate expenseDate = readDate();

        // Take payment method
        PaymentMethod paymentMethod = readPaymentMethod();

        // Take expense type
        ExpenseType expenseType = readExpenseType();

        // Create Expense object
        Expense expense = new Expense(
                expenseId,
                amount,
                category,
                description,
                expenseDate,
                paymentMethod,
                expenseType
        );

        // Send expense to service
        expenseService.addExpense(expense);

        ConsoleUtil.printSuccess("Expense added successfully!");
    }

    // =========================================================
    // VIEW ALL EXPENSES
    // =========================================================

    private static void viewAllExpenses() {

        System.out.println();
        System.out.println("============ ALL EXPENSES ============");

        List<Expense> expenses = expenseService.getAllExpenses();

        if (expenses.isEmpty()) {

            printError("No expenses available.");
            return;
        }

        for (Expense expense : expenses) {

            displayExpense(expense);
        }
    }

    // =========================================================
    // DISPLAY SINGLE EXPENSE
    // =========================================================

    private static void displayExpense(Expense expense) {

        System.out.println();
        System.out.println("----------------------------------------------");
        System.out.println("               EXPENSE DETAILS");
        System.out.println("----------------------------------------------");

        System.out.println(
                "Expense ID       : " + expense.getExpenseId()
        );

        System.out.println(
                "Amount           : ₹" + expense.getAmount()
        );

        System.out.println(
                "Category         : " + expense.getCategory()
        );

        System.out.println(
                "Description      : " + expense.getDescription()
        );

        System.out.println(
                "Expense Date     : " + expense.getExpenseDate()
        );

        System.out.println(
                "Payment Method   : " + expense.getPaymentMethod()
        );

        System.out.println(
                "Expense Type     : " + expense.getExpenseType()
        );

        System.out.println("----------------------------------------------");
    }

    // =========================================================
    // FIND EXPENSE
    // =========================================================

    private static void findExpense() {

        System.out.println();
        System.out.println("============ FIND EXPENSE ============");

        Long expenseId = readLong("Enter Expense ID: ");

        Expense expense = expenseService.getExpenseById(expenseId);

        System.out.println();
        ConsoleUtil.printSuccess("Expense found!");

        displayExpense(expense);
    }

    // =========================================================
    // UPDATE EXPENSE
    // =========================================================

    private static void updateExpense() {

        System.out.println();
        System.out.println("=========== UPDATE EXPENSE ===========");

        // Take ID first
        Long expenseId = readLong(
                "Enter Expense ID to update: "
        );

        // Immediately check whether ID exists
        if (!expenseService.expenseExists(expenseId)) {

            throw new ExpenseNotFoundException(
                    "Expense with ID " + expenseId + " not found."
            );
        }

        System.out.println();
        System.out.println("Enter new expense details:");

        // Amount
        double amount = readDouble("Enter Amount: ");

        // Category
        Category category = readCategory();

        // Description
        String description = readString(
                "Enter Description: "
        );

        // Date entered by user
        LocalDate expenseDate = readDate();

        // Payment method
        PaymentMethod paymentMethod = readPaymentMethod();

        // Expense type
        ExpenseType expenseType = readExpenseType();

        // Create updated object
        Expense updatedExpense = new Expense(
                expenseId,
                amount,
                category,
                description,
                expenseDate,
                paymentMethod,
                expenseType
        );

        // Update through service
        expenseService.updateExpense(updatedExpense);

        ConsoleUtil.printSuccess("Expense updated successfully!");
    }

    // =========================================================
    // DELETE EXPENSE
    // =========================================================

    private static void deleteExpense() {

        System.out.println();

        System.out.println("=========== DELETE EXPENSE ===========");

        Long expenseId = readLong(
                "Enter Expense ID to delete: "
        );

        expenseService.deleteExpense(expenseId);

        ConsoleUtil.printSuccess("Expense deleted successfully!");
    }

    // =========================================================
    // EXPENSE COUNT
    // =========================================================

    private static void showExpenseCount() {

        long count = expenseService.getExpenseCount();

        System.out.println();
        System.out.println("----------------------------------------------");
        System.out.println(
                "Total number of expenses: " + count
        );
        System.out.println("----------------------------------------------");
    }

