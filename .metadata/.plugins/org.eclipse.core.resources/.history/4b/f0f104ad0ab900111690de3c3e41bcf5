private static void showReportMenu() {

  boolean running = true;

  while (running) {

      System.out.println();
      System.out.println("==============================================");
      System.out.println("                EXPENSE REPORTS");
      System.out.println("==============================================");
      System.out.println("1. Overall Expense Report");
      System.out.println("2. Category Expense Report");
      System.out.println("3. Expense Type Report");
      System.out.println("4. Payment Method Report");
      System.out.println("5. Monthly Expense Report");
      System.out.println("0. Back to Main Menu");
      System.out.println("----------------------------------------------");

      int choice = readInt("Enter your choice: ");

      switch (choice) {

          case 1:
              showOverallReport();
              break;

          case 2:
              showCategoryReport();
              break;

          case 3:
              showExpenseTypeReport();
              break;

          case 4:
              showPaymentMethodReport();
              break;

          case 5:
              showMonthlyReport();
              break;

          case 0:
              running = false;
              break;

          default:
              printError(
                      "Invalid report choice."
              );
      }
  }
}
private static void showOverallReport() {

    String report =
            reportService.generateOverallReport();

    System.out.println(report);
}
private static void showCategoryReport() {

    String report =
            reportService.generateCategoryReport();

    System.out.println(report);
}
private static void showExpenseTypeReport() {

    String report =
            reportService.generateExpenseTypeReport();

    System.out.println(report);
}
private static void showPaymentMethodReport() {

    String report =
            reportService.generatePaymentMethodReport();

    System.out.println(report);
}
private static void showMonthlyReport() {

    System.out.println();
    System.out.println("----------------------------------------------");
    System.out.println("             MONTHLY EXPENSE REPORT");
    System.out.println("----------------------------------------------");

    int year = readInt("Enter year: ");

    int month = readInt("Enter month (1-12): ");

    if (month < 1 || month > 12) {

        printError(
                "Invalid month. Please enter a value from 1 to 12."
        );

        return;
    }

    YearMonth selectedMonth =
            YearMonth.of(year, month);

    String report =
            reportService.generateMonthlyReport(
                    selectedMonth
            );

    System.out.println(report);
}
    // =========================================================
    // DELETE ALL EXPENSES
    // =========================================================

    private static void deleteAllExpenses() {

        System.out.println();
        System.out.println("========= DELETE ALL EXPENSES =========");

        String confirmation = readString(
                "Are you sure? Type YES to continue: "
        );

        if (confirmation.equalsIgnoreCase("YES")) {

            expenseService.deleteAllExpenses();

            printSuccess(
                    "All expenses deleted successfully."
            );

